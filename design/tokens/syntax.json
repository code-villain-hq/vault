    "operator": {"tone": "structure", "scopes": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "storage.type.function.arrow"]},
    "punctuation": {"tone": "quiet", "scopes": ["punctuation", "meta.brace", "punctuation.definition.tag", "punctuation.definition.heading", "punctuation.definition.bold", "punctuation.definition.italic", "punctuation.definition.markdown", "punctuation.definition.raw"]},
    "comment": {"tone": "quiet", "scopes": ["comment", "punctuation.definition.comment", "markup.quote", "comment.block.documentation"]},
