{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/types/src",
      "!apps/web/src/design",
      "!**/src-tauri/gen",
      "!**/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noJsRestrictedProperties": {
          "level": "error",
          "options": {
            "entries": [
              {
                "object": "window",
                "property": "confirm",
                "message": "Embedded webviews (the desktop app) can silently refuse it. Use ConfirmDialog from apps/web/src/confirm.tsx."
              }
            ]
          }
        }
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "confirm": "Embedded webviews (the desktop app) can silently refuse it. Use ConfirmDialog from apps/web/src/confirm.tsx."
            }
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
