{
  "name": "raven",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "design:sync": "bun scripts/sync-design.ts",
    "db": "docker compose up -d --wait",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "seed": "bun scripts/seed.ts",
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc -p apps/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "cargo test --workspace && bun test",
    "check": "bun scripts/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
