{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vault-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "7395",
        "--bind",
        "127.0.0.1"
      ],
      "port": 7395
    },
    {
      "name": "forge-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "code/apps/forge",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "forge-dev-passwords",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FORGE_OIDC_ISSUER=",
        "bun",
        "run",
        "--cwd",
        "code/apps/forge",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "layer-mock",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "code/apps/layer",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "glyph-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "code/apps/glyph",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "glyph-dev-fake-model",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GLYPH_OIDC_ISSUER=",
        "GLYPH_PUBLIC_URL=",
        "bun",
        "run",
        "--cwd",
        "code/apps/glyph",
        "dev:fake-model"
      ],
      "port": 5174
    },
    {
      "name": "raven-dev",
      "runtimeExecutable": "bun",
