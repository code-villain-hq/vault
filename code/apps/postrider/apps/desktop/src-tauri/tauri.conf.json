{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postrider",
  "version": "0.1.0",
  "identifier": "eu.codevillain.postrider",
  "build": {
    "devUrl": "http://localhost:5178",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postrider",
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'sha256-kX3tI1hCfWq1iz0M34vCt8+B/O98mENR1iCG4Ku8DVM='",
        "style-src": "'self' 'unsafe-inline' https:",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
