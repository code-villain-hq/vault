{
  "name": "villain-layer",
  "private": true,
  "description": "An agent development environment for macOS",
  "homepage": "https://www.codevillain.eu/",
  "license": "MIT OR Apache-2.0",
  "author": "Code Villain <codevillain@proton.me> (https://www.codevillain.eu/)",
  "repository": {
    "type": "git",
    "url": "https://git.codevillain.eu/code-villain/vault.git",
    "directory": "code/apps/layer"
  },
  "workspaces": [
    "packages/*",
    "web",
    "../../kit/sync/client",
    "../../kit/web"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp check --no-fmt --no-lint && vp build",
    "db": "docker compose up -d --wait",
    "dev:server": "bun scripts/dev-server.ts",
    "build:web": "bun run --cwd web build",
    "seed": "bun scripts/seed.ts",
    "gen:types": "bun scripts/gen-types.ts",
    "guard": "bun scripts/guard.ts",
    "design:sync": "bun scripts/sync-design.ts",
    "design:check": "bun scripts/sync-design.ts --check",
    "check": "bun scripts/check.ts",
    "preview": "vp preview",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "release": "bun scripts/release.ts",
    "release:publish": "bun scripts/release.ts publish",
    "release:mac": "if pgrep -f 'Layer[.]app/Contents/MacOS/villain-layer' >/dev/null; then echo 'Layer is running. Quit it first — replacing the bundle under a running app kills it, and takes its agents with it.'; exit 1; fi; tauri build --bundles app && rm -rf '/Applications/Villain Layer.app' '/Applications/Layer.app' && ditto 'target/release/bundle/macos/Layer.app' '/Applications/Layer.app'",
    "lint": "vp check",
    "format": "vp check --fix"
  },
  "dependencies": {
    "@code-villain/sync-client": "workspace:*",
    "@layer/types": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
