#!/bin/sh
# The fast half of `bun run check`: the guard and the type check, a few
# seconds. The Rust half runs in CI and before a pull request.
# The vault's .githooks/pre-commit runs it, from this folder, when a commit
# touches Layer. Enable once per clone: git config core.hooksPath .githooks
set -e
bun scripts/guard.ts
bunx tsc --noEmit
