# The build context is code/ (docker-compose.yml), so the image can use the
# studio's kit. Only Almanac and the kit go in.
*
!apps/almanac
!kit/sync
!kit/web
!kit/desktop
!kit/scim
!kit/settings
!kit/auth
!kit/notify
**/target
**/node_modules
apps/almanac/apps/web/dist
apps/almanac/apps/desktop/src-tauri/gen
