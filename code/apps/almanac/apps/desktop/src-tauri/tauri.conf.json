{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almanac",
  "version": "0.1.0",
  "identifier": "eu.codevillain.almanac",
  "build": {
    "devUrl": "http://localhost:5177",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Almanac",
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "almanac"
        ]
      }
    }
  }
}
